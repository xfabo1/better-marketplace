<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="01-01-initial-migration-tag" author="xkollar3">
        <tagDatabase tag="0"/>
    </changeSet>

    <changeSet id="01-01-initial-migration-tables" author="xkollar3">
        <createTable tableName="user">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="user_pk"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="surname" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="state">
            <column name="id" type="bigint">
                <constraints primaryKeyName="state_pk" primaryKey="true"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="city">
            <column name="id" type="bigint">
                <constraints primaryKeyName="city_pk" primaryKey="true"/>
            </column>
            <column name="state_id" type="bigint">
                <constraints nullable="false" referencedColumnNames="id" referencedTableName="state" foreignKeyName="city_state_id"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="urban_district">
            <column name="id" type="bigint">
                <constraints primaryKeyName="urban_district_pk" primaryKey="true"/>
            </column>
            <column name="city_id" type="bigint">
                <constraints nullable="false" referencedTableName="city" referencedColumnNames="id" foreignKeyName="urban_district_city_id"/>
            </column>
            <column name="postal_code" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="geography">
                <constraints nullable="false"/>
            </column>
            <column name="approximate_radius" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="review">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="review_pk"/>
            </column>
            <column name="comment" type="varchar(5000)"/>
            <column name="rating" type="float">
                <constraints nullable="false"/>
            </column>
            <column name="reviewer_id" type="bigint">
                <constraints nullable="false" referencedColumnNames="id" referencedTableName="user" foreignKeyName="review_reviewer_user_id"/>
            </column>
            <column name="reviewee_id" type="bigint">
                <constraints nullable="false" referencedTableName="user" referencedColumnNames="id" foreignKeyName="review_reviewee_user_id"/>
            </column>
        </createTable>
        <createTable tableName="file">
            <column name="id" type="bigint">
                <constraints primaryKeyName="file_id" primaryKey="true"/>
            </column>
            <column name="path" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="item">
            <column name="id" type="bigint">
                <constraints primaryKey="true" primaryKeyName="item_pk"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" foreignKeyName="item_user_pk" referencedTableName="user" referencedColumnNames="id"/>
            </column>
            <column name="description" type="varchar(5000)"/>
            <column name="name" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="urban_district_id" type="bigint">
                <constraints nullable="false" foreignKeyName="item_urban_district_id" referencedTableName="urban_district" referencedColumnNames="id"/>
            </column>
        </createTable>
        <createTable tableName="item_photo">
            <column name="item_id" type="bigint">
                <constraints nullable="false" referencedColumnNames="id" referencedTableName="item" foreignKeyName="item_photo_item_id"/>
            </column>
            <column name="file_id" type="bigint">
                <constraints nullable="false" referencedColumnNames="id" referencedTableName="file" foreignKeyName="item_photo_file_id"/>
            </column>
        </createTable>
        <createTable tableName="review_photo">
            <column name="review_id" type="bigint">
                <constraints nullable="false" referencedColumnNames="id" referencedTableName="review" foreignKeyName="review_photo_review_id"/>
            </column>
            <column name="file_id" type="bigint">
                <constraints nullable="false" referencedColumnNames="id" referencedTableName="file" foreignKeyName="review_photo_file_id"/>
            </column>
        </createTable>
    </changeSet>
<!--    TODO: unique constraints/indices-->
</databaseChangeLog>
