insertFile(fileReference) ::= <<
  INSERT INTO file_reference(name,type) VALUES (:fileReference.name, :fileReference.type)
>>

selectFile(id) ::= <<
  SELECT file.*
  FROM file_reference
  WHERE id = :id
>>

updateFile(fileReference) ::= <<
  UPDATE file_reference
  SET name = :fileReference.name
  WHERE id = :fileReference.id
>>
