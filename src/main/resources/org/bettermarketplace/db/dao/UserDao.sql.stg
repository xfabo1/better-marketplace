insertUser(userObject) ::= <<
  INSERT INTO marketplace_user(username,email) VALUES (:userObject.username, :userObject.email)
>>

getUser(id) ::= <<
  SELECT *
  FROM marketplace_user
  WHERE id=:id
>>

getUsers() ::= <<
  SELECT *
  FROM marketplace_user
>>

deleteUser(id) ::= <<
  DELETE
  FROM marketplace_user
  WHERE id=:id
>>
