insertLocations(location) ::= <<
  INSERT INTO location(id, country_code, name, latitude, longitude)
  VALUES (:location.id, :location.countryCode, :location.name, :location.latitude, :location.longitude)
  ON CONFLICT DO NOTHING
>>

findLocations() ::= <<
  SELECT *
  FROM location
>>

findLocation(id) ::= <<
  SELECT *
  FROM location
  WHERE id=:id
>>
