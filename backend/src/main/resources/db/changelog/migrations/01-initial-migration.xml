<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="01-01-initial-migration-tag" author="xfabo1">
        <tagDatabase tag="0"/>
    </changeSet>

    <changeSet id="01-02-add-postgis-extension" author="xfabo1">
        <sql>CREATE EXTENSION IF NOT EXISTS postgis;</sql>
    </changeSet>

    <changeSet id="01-03-initial-migration-tables" author="xfabo1">
        <createTable tableName="location">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="location_pk"/>
            </column>
            <column name="postal_code" type="varchar(10)">
            </column>
            <column name="country_code" type="varchar(10)">
            </column>
            <column name="place_name" type="varchar(1000)"/>
            <column name="latitude" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="longitude" type="double">
                <constraints nullable="false"/>
            </column>
            <column name="region" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="marketplace_user">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="marketplace_user_pk"/>
            </column>
            <column name="password" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="display_items_from_other_country" type="boolean" defaultValue="true"/>
            <column name="created_at" type="timestamp" defaultValue="now()"/>
            <column name="updated_at" type="timestamp" defaultValue="now()"/>
            <column name="username" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="country" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="item">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="item_pk"/>
            </column>
            <column name="created_at" type="timestamp" defaultValue="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValue="now()">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="timestamp"/>
            <column name="email" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false" foreignKeyName="item_user_pk" referencedTableName="marketplace_user" referencedColumnNames="id"/>
            </column>
            <column name="description" type="varchar(2000)"/>
            <column name="name" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="decimal(20,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="bigint">
                <constraints nullable="false" foreignKeyName="item_location_id" referencedTableName="location" referencedColumnNames="id"/>
            </column>
            <column name="image_url" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="varchar(5)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="subcategory" type="varchar(100)">
                <constraints nullable="true"/>
            </column>
            <column name="condition" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="geom" type="geometry(Point,4326)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="01-04-create-indexes" author="xfabo1">
        <createIndex indexName="idx_user_email" tableName="marketplace_user">
            <column name="email"/>
        </createIndex>
        <createIndex indexName="idx_location_postal_code" tableName="location">
            <column name="postal_code"/>
        </createIndex>
        <createIndex indexName="idx_item_user_id" tableName="item">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="item" indexName="idx_item_price">
            <column name="price"/>
        </createIndex>
        <createIndex tableName="item" indexName="idx_item_date_updated">
            <column name="updated_at"/>
        </createIndex>
        <sql>
            CREATE INDEX item_geom_idx ON item USING GIST (geom);
        </sql>
    </changeSet>
</databaseChangeLog>
