<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="01-01-initial-migration-tag" author="xfabo1">
        <tagDatabase tag="0"/>
    </changeSet>

    <changeSet id="01-02-initial-migration-tables" author="xfabo1">
        <createTable tableName="location">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="location_pk"/>
            </column>
            <column name="postal_code" type="varchar(10)">
            </column>
            <column name="country_code" type="varchar(10)">
            </column>
            <column name="name" type="varchar(1000)"/>
            <column name="latitude" type="float">
                <constraints nullable="false"/>
            </column>
            <column name="longitude" type="float">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="marketplace_user">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="marketplace_user_pk"/>
            </column>
            <column name="created_at" type="timestamp" defaultValue="now()"/>
            <column name="updated_at" type="timestamp" defaultValue="now()"/>
            <column name="username" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints unique="true" nullable="false"/>
            </column>
        </createTable>
        <createTable tableName="review">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="review_pk"/>
            </column>
            <column name="created_at" type="timestamp" defaultValue="now()"/>
            <column name="comment" type="varchar(5000)"/>
            <column name="rating" type="float">
                <constraints nullable="false"/>
            </column>
            <column name="reviewer_id" type="bigint">
                <constraints nullable="false" referencedColumnNames="id" referencedTableName="marketplace_user" foreignKeyName="review_reviewer_marketplace_user_id"/>
            </column>
            <column name="reviewee_id" type="bigint">
                <constraints nullable="false" referencedTableName="marketplace_user" referencedColumnNames="id" foreignKeyName="review_reviewee_marketplace_user_id"/>
            </column>
        </createTable>
        <createTable tableName="item">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="item_pk"/>
            </column>
            <column name="created_at" type="timestamp" defaultValue="now()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp" defaultValue="now()">
                <constraints nullable="false"/>
            </column>
            <column name="marketplace_user_id" type="bigint">
                <constraints nullable="false" foreignKeyName="item_marketplace_user_pk" referencedTableName="marketplace_user" referencedColumnNames="id"/>
            </column>
            <column name="description" type="varchar(5000)"/>
            <column name="name" type="varchar(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="bigint">
                <constraints nullable="false" foreignKeyName="item_location_id" referencedTableName="location" referencedColumnNames="id"/>
            </column>
            <column name="deleted" type="boolean"/>
        </createTable>
    </changeSet>
    <changeSet id="01-03-create-indexes" author="xfabo1">
        <createIndex indexName="idx_marketplace_user_email" tableName="marketplace_user">
            <column name="email"/>
        </createIndex>
        <createIndex indexName="idx_location_postal_code" tableName="location">
            <column name="postal_code"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
