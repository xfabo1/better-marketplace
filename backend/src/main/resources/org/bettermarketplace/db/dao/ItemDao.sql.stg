findItemsByPriceAsc(longitude, latitude, minPrice, maxPrice, country, textSearch, maxMeterDistance, lastPrice, lastUpdated, condition, offset, pageSize) ::= <<
   SELECT 
     i.name,
     i.country,
     i.currency,
     i.price,
     l.place_name,
     l.postal_code,
     i.category,
     i.condition
   FROM item i
   INNER JOIN location l ON i.location_id = l.id
   WHERE TRUE
   <if(minPrice)>AND i.price \>= :minPrice<endif>
   <if(maxPrice)>AND i.price \<= :maxPrice<endif>
   <if(country)> AND i.country = :country<endif>
   /* Full-text search with null check */
   <if(textSearch)>AND i.search_vector @@ plainto_tsquery('simple', :textSearch)<endif>
   /* Spatial query with null checks */
   <if(latitude && longitude && maxMeterDistance)>
   AND ST_DWithin(
       i.geom,
       ST_SetSRID(ST_MakePoint(:longitude, :latitude), 4326)::geography,
       :maxMeterDistance
   )
   <endif>
   <if(condition)>AND i.condition = :condition<endif>
   ORDER BY i.price ASC
   OFFSET :offset
   LIMIT :pageSize
>>

findItemsByPriceDesc(longitude, latitude, minPrice, maxPrice, country, textSearch, maxMeterDistance, lastPrice, lastUpdated, condition, offset, pageSize) ::= <<
  SELECT 
     i.name,
     i.country,
     i.currency,
     i.price,
     l.place_name,
     l.postal_code,
     i.category,
     i.condition
  FROM item i
  INNER JOIN location l ON i.location_id = l.id
  WHERE TRUE
  <if(minPrice)>AND i.price \>= :minPrice<endif>
  <if(maxPrice)>AND i.price \<= :maxPrice<endif>
  <if(country)> AND i.country = :country<endif>
  /* Full-text search with null check */
  <if(textSearch)>AND i.search_vector @@ plainto_tsquery('simple', :textSearch)<endif>
  /* Spatial query with null checks */
  <if(latitude && longitude && maxMeterDistance)>
  AND ST_DWithin(
      i.geom,
      ST_SetSRID(ST_MakePoint(:longitude, :latitude), 4326)::geography,
      :maxMeterDistance
  )
  <endif>
  <if(condition)>AND i.condition = :condition<endif>
  ORDER BY i.price DESC
  OFFSET :offset
  LIMIT :pageSize
>>