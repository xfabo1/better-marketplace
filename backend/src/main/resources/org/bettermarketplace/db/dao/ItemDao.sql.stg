findItems() ::= <<
  SELECT *
  FROM item
>>

findItem(id) ::= <<
  SELECT *
  FROM item
  WHERE id=:id
>>

insertItem(itemObject, id) ::= <<
  INSERT INTO item(
    created_at,
    email,
    phone_number,
    marketplace_user_id,
    description,
    name,
    price,
    currency,
    location_id,
    image_url,
    category,
    subcategory)
  VALUES (
    CURRENT_TIMESTAMP,
    :itemObject.email,
    :itemObject.phoneNumber,
    :id,
    :itemObject.description,
    :itemObject.name,
    :itemObject.price,
    :itemObject.currency,
    :itemObject.locationId,
    :itemObject.imageUrl,
    :itemObject.category,
    :itemObject.subcategory
  )
>>

updateItem(name, description, currency, price, locationId, imageUrl, email, phoneNumber, id) ::= <<
  UPDATE item
  SET
      <if(name)>name = :name,<endif>
      <if(description)>description = :description,<endif>
      <if(currency)>currency = :currency,<endif>
      <if(price)>price = :price,<endif>
      <if(locationId)>location_id = :locationId,<endif>
      <if(imageUrl)>image_url = :imageUrl,<endif>
      <if(email)>email = :email,<endif>
      <if(phoneNumber)>phone_number = :phoneNumber,<endif>
      updated_at = CURRENT_TIMESTAMP
  WHERE id = :id
>>

deleteItem(id) ::= <<
  DELETE
  FROM item
  WHERE id=:id
>>
