findItem(id) ::= <<
  SELECT 
    i.*,
    u.username,
    l.place_name,
    l.postal_code
  FROM item i
  INNER JOIN marketplace_user u ON i.user_id = u.id
  INNER JOIN location l ON i.location_id = l.id
  WHERE i.id=:id
>>

insertItem(itemObject, userId, longitude, latitude, country) ::= <<
  INSERT INTO item(
    created_at,
    email,
    phone_number,
    user_id,
    description,
    name,
    price,
    currency,
    location_id,
    image_url,
    country,
    category,
    subcategory,
    condition,
    geom
  )
  VALUES (
    CURRENT_TIMESTAMP,
    :itemObject.email,
    :itemObject.phoneNumber,
    :userId,
    :itemObject.description,
    :itemObject.name,
    :itemObject.price,
    :itemObject.currency,
    :itemObject.locationId,
    :itemObject.imageUrl,
    :country,
    :itemObject.category,
    :itemObject.subcategory,
    :itemObject.condition,
    ST_SetSRID(ST_MakePoint(:longitude, :latitude), 4326)
  )
>>

updateItem(name, description, currency, price, locationId, imageUrl, email, phoneNumber, longitude, latitude, id, country, condition) ::= <<
  UPDATE item
  SET
      <if(name)>name = :name,<endif>
      <if(description)>description = :description,<endif>
      <if(currency)>currency = :currency,<endif>
      <if(price)>price = :price,<endif>
      <if(locationId)>location_id = :locationId,<endif>
      <if(imageUrl)>image_url = :imageUrl,<endif>
      <if(email)>email = :email,<endif>
      <if(phoneNumber)>phone_number = :phoneNumber,<endif>
      <if(country)>country = :country,<endif>
      <if(longitude && latitude)>geom = ST_SetSRID(ST_MakePoint(:longitude, :latitude), 4326),<endif>
      <if(condition)>condition = :condition,<endif>
      updated_at = CURRENT_TIMESTAMP
  WHERE id = :id
>>

deleteItem(id) ::= <<
  DELETE
  FROM item
  WHERE id=:id
>>

findItemsByUpdateTimeAsc(longitude, latitude, minPrice, maxPrice, country, textSearch, maxMeterDistance, lastPrice, lastUpdated, condition, offset, pageSize) ::= <<
   SELECT 
     i.name,
     i.country,
     i.currency,
     i.price,
     l.place_name,
     l.postal_code,
     i.category,
     i.condition
   FROM item i
   INNER JOIN location l ON i.location_id = l.id
   WHERE TRUE
   <if(minPrice)>AND i.price \>= :minPrice<endif>
   <if(maxPrice)>AND i.price \<= :maxPrice<endif>
   <if(country)> AND i.country = :country<endif>
   /* Full-text search with null check */
   <if(textSearch)>AND i.search_vector @@ plainto_tsquery('simple', :textSearch)<endif>
   /* Spatial query with null checks */
   <if(latitude && longitude && maxMeterDistance)>
   AND ST_DWithin(
       i.geom,
       ST_SetSRID(ST_MakePoint(:longitude, :latitude), 4326)::geography,
       :maxMeterDistance
   )
   <endif>
   <if(condition)>AND i.condition = :condition<endif>
   ORDER BY i.updated_at ASC
   OFFSET :offset
   LIMIT :pageSize
>>

