insertUser(registerUserObject, password) ::= <<
  INSERT INTO marketplace_user(
    username,
    email,
    password,
    created_at
  )
  VALUES (
    :registerUserObject.username,
    :registerUserObject.email,
    :password,
    CURRENT_TIMESTAMP
  )
>>

getUser(id) ::= <<
  SELECT *
  FROM marketplace_user
  WHERE id=:id
>>

getUsers() ::= <<
  SELECT *
  FROM marketplace_user
>>

deleteUser(id) ::= <<
  DELETE
  FROM marketplace_user
  WHERE id=:id
>>


getUserByEmail(email) ::= <<
  SELECT *
  FROM marketplace_user
  WHERE email=:email
>>


getUserByUsername(username) ::= <<
  SELECT *
  FROM marketplace_user
  WHERE username=:username
>>

updateUser(password, id) ::= <<
  UPDATE marketplace_user
  SET
  <if(password)>
    password = :password,<endif>
    updated_at = CURRENT_TIMESTAMP
  WHERE id = :id
>>

