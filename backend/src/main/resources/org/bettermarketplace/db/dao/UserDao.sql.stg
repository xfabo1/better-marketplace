insertUser(userObject) ::= <<
  INSERT INTO marketplace_user(username,email,password,display_other_country_items,country)
  VALUES (:userObject.username, :userObject.email, :userObject.password, :userObject.displayItemsFromOtherCountry, :userObject.country)
>>

getUser(id) ::= <<
  SELECT *
  FROM marketplace_user
  WHERE id=:id
>>

getUsers() ::= <<
  SELECT *
  FROM marketplace_user
>>

deleteUser(id) ::= <<
  DELETE
  FROM marketplace_user
  WHERE id=:id
>>


getUserByEmail(email) ::= <<
  SELECT *
  FROM marketplace_user
  WHERE email=:email
>>


getUserByUsername(username) ::= <<
  SELECT *
  FROM marketplace_user
  WHERE username=:username
>>