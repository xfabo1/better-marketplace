insertLocations(location) ::= <<
  INSERT INTO location(postal_code, country_code, place_name, latitude, longitude, region, city)
  VALUES (:location.postalCode, :location.countryCode, :location.placeName, :location.latitude, :location.longitude, :location.region, :location.city)
  ON CONFLICT DO NOTHING
>>

findLocations() ::= <<
  SELECT *
  FROM location
>>

findLocation(id) ::= <<
  SELECT *
  FROM location
  WHERE id=:id
>>

insertLocation(location) ::= <<
  INSERT INTO location(postal_code, country_code, place_name, latitude, longitude, region, city)
  VALUES (:location.postalCode, :location.countryCode, :location.placeName, :location.latitude, :location.longitude, :location.region, :location.city)
  ON CONFLICT DO NOTHING
>>

deleteLocation(id) ::= <<
  DELETE
  FROM location
  WHERE id=:id
>>
