insertLocations(location) ::= <<
  INSERT INTO location(postal_code, country_code, name, latitude, longitude)
  VALUES (:location.postalCode, :location.countryCode, :location.placeName, :location.latitude, :location.longitude)
  ON CONFLICT DO NOTHING
>>

findLocations() ::= <<
  SELECT *
  FROM location
>>

findLocation(id) ::= <<
  SELECT *
  FROM location
  WHERE id=:id
>>

insertLocation(location) ::= <<
  INSERT INTO location(postal_code, country_code, name, latitude, longitude)
  VALUES (:location.postalCode, :location.countryCode, :location.placeName, :location.latitude, :location.longitude)
>>

deleteLocation(id) ::= <<
  DELETE
  FROM location
  WHERE id=:id
>>
